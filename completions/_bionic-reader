#compdef bionic-reader

autoload -U is-at-least

_bionic-reader() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-t+[Transform this text instead of reading stdin]:TEXT:_default' \
'--text=[Transform this text instead of reading stdin]:TEXT:_default' \
'--fraction=[Fraction of each selected word to emphasize (0 through 1)]:FRACTION:_default' \
'--every=[Emphasize the first eligible word and then every Nth word]:EVERY:_default' \
'--min-word-length=[Minimum number of letters a word must have to receive emphasis]:MIN_WORD_LENGTH:_default' \
'--style=[When to apply emphasis\: automatically for terminals, always, or never]:STYLE:(auto always never)' \
'--config=[Read an explicit TOML configuration file]:CONFIG:_files' \
'*--exclude=[Add a command name to the interactive passthrough exclusions]:EXCLUDE:_default' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
":: :_bionic-reader_commands" \
"*::: :->bionic-reader" \
&& ret=0
    case $state in
    (bionic-reader)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:bionic-reader-command-$line[1]:"
        case $line[1] in
            (session)
_arguments "${_arguments_options[@]}" : \
'--shell=[Bash, Zsh, or fish executable (defaults to SHELL)]:SHELL:_default' \
'--fraction=[Fraction of each selected word to emphasize (0 through 1)]:FRACTION:_default' \
'--every=[Emphasize the first eligible word and then every Nth word]:EVERY:_default' \
'--min-word-length=[Minimum number of letters a word must have to receive emphasis]:MIN_WORD_LENGTH:_default' \
'--style=[When to apply emphasis\: automatically for terminals, always, or never]:STYLE:(auto always never)' \
'--config=[Read an explicit TOML configuration file]:CONFIG:_files' \
'*--exclude=[Add a command name to the interactive passthrough exclusions]:EXCLUDE:_default' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(init)
_arguments "${_arguments_options[@]}" : \
'--fraction=[Fraction of each selected word to emphasize (0 through 1)]:FRACTION:_default' \
'--every=[Emphasize the first eligible word and then every Nth word]:EVERY:_default' \
'--min-word-length=[Minimum number of letters a word must have to receive emphasis]:MIN_WORD_LENGTH:_default' \
'--style=[When to apply emphasis\: automatically for terminals, always, or never]:STYLE:(auto always never)' \
'--config=[Read an explicit TOML configuration file]:CONFIG:_files' \
'*--exclude=[Add a command name to the interactive passthrough exclusions]:EXCLUDE:_default' \
'-h[Print help]' \
'--help[Print help]' \
':shell:(bash zsh fish)' \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
'--fraction=[Fraction of each selected word to emphasize (0 through 1)]:FRACTION:_default' \
'--every=[Emphasize the first eligible word and then every Nth word]:EVERY:_default' \
'--min-word-length=[Minimum number of letters a word must have to receive emphasis]:MIN_WORD_LENGTH:_default' \
'--style=[When to apply emphasis\: automatically for terminals, always, or never]:STYLE:(auto always never)' \
'--config=[Read an explicit TOML configuration file]:CONFIG:_files' \
'*--exclude=[Add a command name to the interactive passthrough exclusions]:EXCLUDE:_default' \
'-h[Print help]' \
'--help[Print help]' \
':shell:(bash zsh fish)' \
&& ret=0
;;
(on)
_arguments "${_arguments_options[@]}" : \
'--fraction=[Fraction of each selected word to emphasize (0 through 1)]:FRACTION:_default' \
'--every=[Emphasize the first eligible word and then every Nth word]:EVERY:_default' \
'--min-word-length=[Minimum number of letters a word must have to receive emphasis]:MIN_WORD_LENGTH:_default' \
'--style=[When to apply emphasis\: automatically for terminals, always, or never]:STYLE:(auto always never)' \
'--config=[Read an explicit TOML configuration file]:CONFIG:_files' \
'*--exclude=[Add a command name to the interactive passthrough exclusions]:EXCLUDE:_default' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(off)
_arguments "${_arguments_options[@]}" : \
'--fraction=[Fraction of each selected word to emphasize (0 through 1)]:FRACTION:_default' \
'--every=[Emphasize the first eligible word and then every Nth word]:EVERY:_default' \
'--min-word-length=[Minimum number of letters a word must have to receive emphasis]:MIN_WORD_LENGTH:_default' \
'--style=[When to apply emphasis\: automatically for terminals, always, or never]:STYLE:(auto always never)' \
'--config=[Read an explicit TOML configuration file]:CONFIG:_files' \
'*--exclude=[Add a command name to the interactive passthrough exclusions]:EXCLUDE:_default' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(toggle)
_arguments "${_arguments_options[@]}" : \
'--fraction=[Fraction of each selected word to emphasize (0 through 1)]:FRACTION:_default' \
'--every=[Emphasize the first eligible word and then every Nth word]:EVERY:_default' \
'--min-word-length=[Minimum number of letters a word must have to receive emphasis]:MIN_WORD_LENGTH:_default' \
'--style=[When to apply emphasis\: automatically for terminals, always, or never]:STYLE:(auto always never)' \
'--config=[Read an explicit TOML configuration file]:CONFIG:_files' \
'*--exclude=[Add a command name to the interactive passthrough exclusions]:EXCLUDE:_default' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(reload)
_arguments "${_arguments_options[@]}" : \
'--fraction=[Fraction of each selected word to emphasize (0 through 1)]:FRACTION:_default' \
'--every=[Emphasize the first eligible word and then every Nth word]:EVERY:_default' \
'--min-word-length=[Minimum number of letters a word must have to receive emphasis]:MIN_WORD_LENGTH:_default' \
'--style=[When to apply emphasis\: automatically for terminals, always, or never]:STYLE:(auto always never)' \
'--config=[Read an explicit TOML configuration file]:CONFIG:_files' \
'*--exclude=[Add a command name to the interactive passthrough exclusions]:EXCLUDE:_default' \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(bypass)
_arguments "${_arguments_options[@]}" : \
'--fraction=[Fraction of each selected word to emphasize (0 through 1)]:FRACTION:_default' \
'--every=[Emphasize the first eligible word and then every Nth word]:EVERY:_default' \
'--min-word-length=[Minimum number of letters a word must have to receive emphasis]:MIN_WORD_LENGTH:_default' \
'--style=[When to apply emphasis\: automatically for terminals, always, or never]:STYLE:(auto always never)' \
'--config=[Read an explicit TOML configuration file]:CONFIG:_files' \
'*--exclude=[Add a command name to the interactive passthrough exclusions]:EXCLUDE:_default' \
'-h[Print help]' \
'--help[Print help]' \
'*::command:_default' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_bionic-reader__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:bionic-reader-help-command-$line[1]:"
        case $line[1] in
            (session)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(init)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(on)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(off)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(toggle)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(reload)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(bypass)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_bionic-reader_commands] )) ||
_bionic-reader_commands() {
    local commands; commands=(
'session:Start an interactive reading session' \
'init:Print an opt-in initialization snippet for your shell configuration' \
'completions:Print completion definitions for your shell' \
'on:Enable emphasis in the current reading session' \
'off:Disable emphasis in the current reading session' \
'toggle:Toggle emphasis in the current reading session' \
'reload:Reload settings at the next shell command boundary' \
'bypass:Run a command without emphasis, restoring the prior state afterward' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'bionic-reader commands' commands "$@"
}
(( $+functions[_bionic-reader__subcmd__bypass_commands] )) ||
_bionic-reader__subcmd__bypass_commands() {
    local commands; commands=()
