class BionicReader < Formula
  desc "Local word-prefix emphasis for text streams and terminal sessions"
  homepage "https://github.com/arturoaviles/bionic-reader"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/arturoaviles/bionic-reader/releases/download/v#{version}/bionic-reader-v#{version}-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_MAC_ARM64@"
    end
    on_intel do
      url "https://github.com/arturoaviles/bionic-reader/releases/download/v#{version}/bionic-reader-v#{version}-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA256_MAC_X64@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/arturoaviles/bionic-reader/releases/download/v#{version}/bionic-reader-v#{version}-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_LINUX_ARM64@"
    end
    on_intel do
      url "https://github.com/arturoaviles/bionic-reader/releases/download/v#{version}/bionic-reader-v#{version}-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256_LINUX_X64@"
    end
  end

  def install
    bin.install "bin/bionic-reader"
    pkgshare.install Dir["share/bionic-reader/*"]
    bash_completion.install "share/bionic-reader/completions/bionic-reader.bash" => "bionic-reader"
    zsh_completion.install "share/bionic-reader/completions/_bionic-reader"
    fish_completion.install "share/bionic-reader/completions/bionic-reader.fish" => "bionic-reader.fish"
    doc.install "README.md", "LICENSE"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/bionic-reader --version")
  end
end
